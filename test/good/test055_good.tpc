// Test 55 (Test variables locales avancé)


void calculations(int a, int b) {
    int c;
    
    a = 13;
    b = 6;

    c = 3;

    putint(a);
    putchar('\n');
    putint(b);
    putchar('\n');
    putint(c);
    putchar('\n');
}

int main(void) {
    int x, y;
    int c;
    
    x = 9;
    y = 7;

    c = 2;

    putint(x);
    putchar('\n');
    putint(y);
    putchar('\n');
    putint(c);
    putchar('\n');
    putchar('\n');

    calculations(x, y);
    
    return 0;
}