// Test 45

struct engine {
    int power, size, cost;
};

struct aircraft {
    int height, width;
    char pilot;
    struct engine motor;
};

void cut_price_aircraft(struct engine e) {
    e.power = e.power / 2;
    e.size = e.size / 3;
    e.cost = e.cost - 40000;

    if (e.cost < 0) {
        e.cost = 10000;
    }
}

int main(void) {
    struct aircraft my_plane, my_shuttle, my_satellite;
    my_plane = alpha;

    cut_price_aircraft(my_plane.motor);

    return 0;
}