// Test 43

struct engine {
    int power, size, cost;
};

struct aircraft {
    int height, width;
    char pilot;
    struct engine motor;
};

void fusion_aircraft(struct aircraft a1, struct aircraft a2) {
    a1.height = a2.height * 2;
    a1.width = a2.width * 2;
}

int main(void) {
    struct aircraft my_plane, my_shuttle, my_satellite;
    my_plane = alpha;
    my_satellite = delta;

    fusion_aircraft(alpha, delta);

    return 0;
}