// Test 33

int UNUSED_GLOBAL_INT;
char UNUSED_GLOBAL_CHAR;

char get_first_letter(int n) {
    if (n >= 0) {
        return 'u';
    }
    return 't';
}

int main(void) {
    int a, b;
    char v1, v2;
    a = 2;
    b = -a;

    v1 = get_first_letter(a);
    v2 = get_first_letter(b);

    return 0;
}